    <script>
        // State management
        let currentDate = new Date(); // defaults to current month/year
        let currentViewMode = 'calendar'; // 'calendar' or 'list'
        let activeModalDateKey = null;
        let modalTempPaid = false;

        // Load persisted data from localStorage or initialize empty object
        let stipendData = JSON.parse(localStorage.getItem('stipend_tracker_data_kes350') || '{}');

        // Initialize application on load
        window.onload = function() {
            renderApp();
        };

        function changeMonth(direction) {
            currentDate.setMonth(currentDate.getMonth() + direction);
            renderApp();
        }

        function toggleViewMode() {
            currentViewMode = currentViewMode === 'calendar' ? 'list' : 'calendar';
            const calCont = document.getElementById('calendarViewContainer');
            const listCont = document.getElementById('listViewContainer');
            const toggleBtn = document.getElementById('viewModeToggleBtn');
            const secTitle = document.getElementById('sectionTitle');

            if (currentViewMode === 'list') {
                calCont.classList.add('hidden');
                listCont.classList.remove('hidden');
                toggleBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> Switch to Calendar View`;
                secTitle.innerText = "Daily Payment List Ledger";
            } else {
                calCont.classList.remove('hidden');
                listCont.classList.add('hidden');
                toggleBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg> Switch to List View`;
                secTitle.innerText = "Daily Payment Calendar";
            }
            renderApp();
        }

        function getMonthKey(year, month) {
            return `${year}-${String(month + 1).padStart(2, '0')}`;
        }

        function getDaysInMonth(year, month) {
            return new Date(year, month + 1, 0).getDate();
        }

        function renderApp() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            
            // Header display
            document.getElementById('currentMonthDisplay').innerText = `${monthNames[month]} ${year}`;

            const daysInMonth = getDaysInMonth(year, month);
            const mKey = getMonthKey(year, month);
            if (!stipendData[mKey]) {
                stipendData[mKey] = {};
            }

            let totalPaidCount = 0;
            let notesLoggedCount = 0;

            for (let d = 1; d <= daysInMonth; d++) {
                const dayKey = `${mKey}-${String(d).padStart(2, '0')}`;
                if (stipendData[mKey][dayKey] && stipendData[mKey][dayKey].paid) {
                    totalPaidCount++;
                    if (stipendData[mKey][dayKey].notes && stipendData[mKey][dayKey].notes.trim() !== '') {
                        notesLoggedCount++;
                    }
                }
            }

            const totalDisbursed = totalPaidCount * 350;
            const monthTarget = daysInMonth * 350;
            const progressPercent = Math.round((totalPaidCount / daysInMonth) * 100);

            // Update stats
            document.getElementById('statTotalDisbursed').innerText = `KES ${totalDisbursed.toLocaleString()}`;
            document.getElementById('statMonthTarget').innerText = `KES ${monthTarget.toLocaleString()}`;
            document.getElementById('statDaysPaidCount').innerText = `${totalPaidCount} / ${daysInMonth} days paid`;
            document.getElementById('statProgressBar').style.width = `${progressPercent}%`;
            document.getElementById('statProgressPercent').innerText = `${progressPercent}%`;
            document.getElementById('statNotesCount').innerText = `${notesLoggedCount} / ${totalPaidCount}`;

            // Days remaining calculation
            const today = new Date();
            if (year === today.getFullYear() && month === today.getMonth()) {
                const rem = daysInMonth - today.getDate();
                document.getElementById('statDaysRemaining').innerText = rem >= 0 ? `${rem} days remaining in month` : `Month completed`;
            } else if (year < today.getFullYear() || (year === today.getFullYear() && month < today.getMonth())) {
                document.getElementById('statDaysRemaining').innerText = `Past month statement`;
            } else {
                document.getElementById('statDaysRemaining').innerText = `Future month planning`;
            }

            if (currentViewMode === 'calendar') {
                renderCalendarGrid(year, month, daysInMonth, mKey);
            } else {
                renderListTable(year, month, daysInMonth, mKey);
            }
        }

        function renderCalendarGrid(year, month, daysInMonth, mKey) {
            const grid = document.getElementById('calendarGrid');
            grid.innerHTML = '';

            // Get first day of week (0 = Sunday, 1 = Monday ...)
            let firstDayIndex = new Date(year, month, 1).getDay();
            // Adjust so Monday is 0
            firstDayIndex = (firstDayIndex === 0) ? 6 : firstDayIndex - 1;

            // Blank padding for previous month offset
            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "h-28 bg-slate-900/30 rounded-2xl border border-slate-800/40 opacity-40";
                grid.appendChild(emptyCell);
            }

            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

            for (let d = 1; d <= daysInMonth; d++) {
                const dayKey = `${mKey}-${String(d).padStart(2, '0')}`;
                const entry = stipendData[mKey][dayKey] || { paid: false, notes: '' };
                const isPaid = entry.paid;
                const hasNote = entry.notes && entry.notes.trim().length > 0;

                const cell = document.createElement('div');
                cell.className = `h-28 rounded-2xl border p-3 flex flex-col justify-between transition cursor-pointer relative overflow-hidden ${
                    isPaid 
                        ? 'bg-emerald-950/20 border-emerald-500/40 hover:border-emerald-500 shadow-sm shadow-emerald-950' 
                        : 'bg-slate-900/60 border-slate-800 hover:border-slate-600'
                }`;
                cell.onclick = () => openModal(dayKey, d, monthNames[month], year);

                let badgeHtml = isPaid 
                    ? `<span class="bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 w-fit"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> KES 350</span>`
                    : `<span class="bg-slate-800 text-slate-400 text-[10px] font-medium px-2 py-0.5 rounded-full w-fit">Pending</span>`;

                let noteIconHtml = hasNote
                    ? `<span class="text-amber-400" title="M-Pesa Note Attached"><svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></span>`
                    : '';

                cell.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold ${isPaid ? 'text-emerald-300' : 'text-slate-200'}">${d}</span>
                        ${noteIconHtml}
                    </div>
                    <div>
                        <p class="text-[11px] font-medium ${isPaid ? 'text-emerald-400 font-semibold' : 'text-slate-400'}">KES ${isPaid ? '350' : '0'}</p>
                        <div class="mt-1">${badgeHtml}</div>
                    </div>
                `;
                grid.appendChild(cell);
            }
        }

        function renderListTable(year, month, daysInMonth, mKey) {
            const tbody = document.getElementById('listTableBody');
            tbody.innerHTML = '';
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            const fullMonthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

            for (let d = 1; d <= daysInMonth; d++) {
                const dayKey = `${mKey}-${String(d).padStart(2, '0')}`;
                const entry = stipendData[mKey][dayKey] || { paid: false, notes: '' };
                const isPaid = entry.paid;
                const noteText = entry.notes ? escapeHtml(entry.notes) : '<span class="text-slate-600 italic">No M-Pesa transaction note recorded</span>';

                const dateObj = new Date(year, month, d);
                const dayName = dateObj.toLocaleDateString('en-US', { weekday: 'short' });

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/40 transition";
                tr.innerHTML = `
                    <td class="py-3 px-4 font-semibold text-slate-200">${d} ${monthNames[month]} ${year}</td>
                    <td class="py-3 px-4 text-slate-400">${dayName}</td>
                    <td class="py-3 px-4">
                        ${isPaid 
                            ? '<span class="bg-emerald-500/20 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-full inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Paid</span>' 
                            : '<span class="bg-slate-800 text-slate-400 text-xs font-medium px-2.5 py-1 rounded-full">Pending</span>'}
                    </td>
                    <td class="py-3 px-4 font-bold ${isPaid ? 'text-emerald-400' : 'text-slate-400'}">KES ${isPaid ? '350' : '0'}</td>
                    <td class="py-3 px-4 text-xs text-slate-300 max-w-xs truncate" title="${entry.notes || ''}">${noteText}</td>
                    <td class="py-3 px-4 text-right">
                        <button onclick="openModal('${dayKey}', ${d}, '${monthNames[month]}', ${year})" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1.5 rounded-lg text-xs font-semibold transition">Edit / Note</button>
                    </td>
                `;
                tbody.appendChild(tr);
            }
        }

        // Modal Controls
        function openModal(dayKey, dayNum, monthName, year) {
            activeModalDateKey = dayKey;
            const mKey = dayKey.substring(0, 7);
            const entry = stipendData[mKey][dayKey] || { paid: true, notes: '' }; // default to paid when clicked for ease

            modalTempPaid = entry.paid !== undefined ? entry.paid : true;
            document.getElementById('modalMpesaNotes').value = entry.notes || '';
            document.getElementById('modalTitle',).innerText = `Log Stipend for ${dayNum} ${monthName} ${year}`;
            document.getElementById('modalSubtitle').innerText = `Daily Food Allocation • KES 350`;

            updateModalStatusButtons();
            document.getElementById('extractedMetaBadge').classList.add('hidden');
            document.getElementById('logModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('logModal').classList.add('hidden');
            activeModalDateKey = null;
        }

        function setModalPaidStatus(status) {
            modalTempPaid = status;
            updateModalStatusButtons();
        }

        function updateModalStatusButtons() {
            const paidBtn = document.getElementById('modalStatusPaidBtn');
            const unpaidBtn = document.getElementById('modalStatusUnpaidBtn');

            if (modalTempPaid) {
                paidBtn.className = "py-3 px-4 rounded-xl border border-emerald-500 bg-emerald-500/20 text-emerald-300 font-semibold text-sm flex items-center justify-center gap-2 transition shadow-md shadow-emerald-500/10";
                unpaidBtn.className = "py-3 px-4 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 font-semibold text-sm flex items-center justify-center gap-2 transition";
            } else {
                paidBtn.className = "py-3 px-4 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 font-semibold text-sm flex items-center justify-center gap-2 transition";
                unpaidBtn.className = "py-3 px-4 rounded-xl border border-rose-500 bg-rose-500/20 text-rose-300 font-semibold text-sm flex items-center justify-center gap-2 transition shadow-md shadow-rose-500/10";
            }
        }

        function autoExtractMpesa() {
            const notes = document.getElementById('modalMpesaNotes').value;
            if (!notes.trim()) {
                showToast("Please paste an M-Pesa message first.", "error");
                return;
            }

            // Quick pattern matching for M-Pesa transaction code (e.g. QKJ8293XYZ Confirmed)
            const codeMatch = notes.match(/([A-Z0-9]{10})\s+Confirmed/i) || notes.match(/([A-Z0-9]{10})/);
            const amtMatch = notes.match(/Ksh\s*([0-9,]+\.\d{2})/i) || notes.match(/([0-9,]+\.\d{2})\s+sent/i);

            const badge = document.getElementById('extractedMetaBadge');
            const textElem = document.getElementById('extractedMetaText');

            let msg = "Parsed successfully:";
            if (codeMatch) msg += ` Code: ${codeMatch[1]}`;
            if (amtMatch) msg += ` Amount: Ksh ${amtMatch[1]}`;

            textElem.innerText = msg;
            badge.classList.remove('hidden');
            showToast("M-Pesa details detected!", "success");
        }

        function saveModalData() {
            if (!activeModalDateKey) return;
            const mKey = activeModalDateKey.substring(0, 7);
            const notes = document.getElementById('modalMpesaNotes').value;

            if (!stipendData[mKey]) {
                stipendData[mKey] = {};
            }

            stipendData[mKey][activeModalDateKey] = {
                paid: modalTempPaid,
                notes: notes
            };

            localStorage.setItem('stipend_tracker_data_kes350', JSON.stringify(stipendData));
            closeModal();
            renderApp();
            showToast("Daily stipend record saved successfully!", "success");
        }

        // PDF Generation Trigger & Print Setup
        function triggerPDFExport() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            
            document.getElementById('printHeaderMonth').innerText = `${monthNames[month]} ${year}`;
            document.getElementById('printHeaderDate').innerText = `Generated on: ${new Date().toLocaleDateString('en-US', { dateStyle: 'long' })}`;

            const mKey = getMonthKey(year, month);
            const daysInMonth = getDaysInMonth(year, month);

            if (!stipendData[mKey]) stipendData[mKey] = {};

            let totalPaid = 0;
            let printTbody = document.getElementById('printTableBody');
            printTbody.innerHTML = '';

            for (let d = 1; d <= daysInMonth; d++) {
                const dayKey = `${mKey}-${String(d).padStart(2, '0')}`;
                const entry = stipendData[mKey][dayKey] || { paid: false, notes: '' };
                const isPaid = entry.paid;
                if (isPaid) totalPaid++;

                const tr = document.createElement('tr');
                tr.className = isPaid ? 'bg-white' : 'bg-slate-50 text-slate-400';
                tr.innerHTML = `
                    <td class="p-2.5 border-r border-slate-300 font-semibold">${d} ${monthNames[month]} ${year}</td>
                    <td class="p-2.5 border-r border-slate-300 text-center font-medium ${isPaid ? 'text-emerald-700' : 'text-slate-400'}">${isPaid ? 'COMPLETED' : 'PENDING'}</td>
                    <td class="p-2.5 border-r border-slate-300 text-right font-bold ${isPaid ? 'text-slate-900' : 'text-slate-400'}">KES ${isPaid ? '350.00' : '0.00'}</td>
                    <td class="p-2.5 text-slate-700 text-xs font-mono whitespace-pre-wrap">${entry.notes ? escapeHtml(entry.notes) : '<span class="text-slate-400 font-sans italic">No transaction SMS note logged</span>'}</td>
                `;
                printTbody.appendChild(tr);
            }

            const totalDisbursed = totalPaid * 350;
            const targetBudget = daysInMonth * 350;

            document.getElementById('printSummaryTarget').innerText = `KES ${targetBudget.toLocaleString()}.00`;
            document.getElementById('printSummaryDisbursed').innerText = `KES ${totalDisbursed.toLocaleString()}.00`;
            document.getElementById('printSummaryDays').innerText = `${totalPaid} / ${daysInMonth} Days`;

            // Trigger browser print dialog for professional PDF generation
            window.print();
        }

        // Toast Helper
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const msgElem = document.getElementById('toastMessage');
            const iconElem = document.getElementById('toastIcon');

            msgElem.innerText = message;
            if (type === 'success') {
                iconElem.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
                iconElem.className = "text-emerald-400";
            } else {
                iconElem.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                iconElem.className = "text-rose-400";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
